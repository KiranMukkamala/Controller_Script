Schedule_tables {
		DIAG_19200_5 { 
			MasterReq delay 10.0 ms;
			SlaveResp delay 10.0 ms;
		}
		DIAG_RESP_19200_5 { 
			SlaveResp delay 10.0 ms;
		}
		DIAG_RQ_19200_5 { 
			MasterReq delay 10.0 ms;
		}
		ERR_ST_AAM { 
			ErrorStatusAAMHSRLIN delay 20.0 ms;
		}
		INIT_AAM_HSRO { 
			AssignFrameIdRange { AAM_HSRO , 0, 20, 85, 214, 151 }  delay 10.0 ms;
			SaveConfiguration { AAM_HSRO }  delay 10.0 ms;
		}
		INIT_LKA_R { 
			AssignFrameIdRange { LKA_R , 0, 193, 139, 202, 76 }  delay 10.0 ms;
			SaveConfiguration { LKA_R }  delay 10.0 ms;
		}
		RUN_MAIN { 
			Sporadic_Frame_Holder_LIN_HECK_3 delay 10.0 ms;
			BRCEnvironmentConditionAAMHSRLIN delay 10.0 ms;
			CommErr1LKARLIN delay 20.0 ms;
			StatusChargingFlapRightLIN delay 10.0 ms;
			Sporadic_Frame_Holder_LIN_HECK_3 delay 40.0 ms;
			StatusAAMHSRLIN delay 10.0 ms;
			Sporadic_Frame_Holder_LIN_HECK_3 delay 40.0 ms;
			StatusChargingFlapRightLIN delay 10.0 ms;
			Sporadic_Frame_Holder_LIN_HECK_3 delay 30.0 ms;
			VehicleDataChargingFlapRightLIN delay 20.0 ms;
		}
	}

